{
  "name": "uav-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "FLEET", "class_name": "FleetRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["FleetRoom"]}],
  "observability": {"enabled": true}
}
